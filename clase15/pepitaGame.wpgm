import pepita.*
import extras.*
import teclado.*
import wollok.game.*

program PepitaGame {
	game.title("Pepita")
	game.height(10)
	game.width(10)
	game.boardGround("fondo2.jpg")
	
	
	game.addVisual(silvestre)
	game.addVisual(nido)
	game.addVisual(manzana)
	game.addVisual(alpiste)
	game.addVisualCharacter(pepita)

	configuracionTeclas.configurarHabilidad()
	
	game.onCollideDo(pepita,{elemento => elemento.teEncontre()})
	game.start()
}